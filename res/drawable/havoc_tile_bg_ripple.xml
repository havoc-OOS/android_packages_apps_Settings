<?xml version="1.0" encoding="utf-8"?>
<!--
  Interactive ripple tile with refined gradient base
  -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/havoc_accent_dim">

    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <item>
        <layer-list>
            <!-- Border -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/havoc_tile_border" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <!-- Inner gradient fill -->
            <item
                android:left="0.8dp"
                android:top="0.8dp"
                android:right="0.8dp"
                android:bottom="0.8dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#18181E"
                        android:endColor="#121216"
                        android:angle="135" />
                    <corners android:radius="19.2dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
