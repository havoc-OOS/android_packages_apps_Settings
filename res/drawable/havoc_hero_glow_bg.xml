<?xml version="1.0" encoding="utf-8"?>
<!-- Havoc: Outer purple glow for the hero theme card -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Glow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="#4D7B61FF" /> <!-- Semi-transparent purple -->
        </shape>
    </item>
    <!-- Inner Card (slightly smaller to show glow) -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/havoc_tile_bg" />
            <stroke android:width="1dp" android:color="#22FFFFFF" />
        </shape>
    </item>
</layer-list>
